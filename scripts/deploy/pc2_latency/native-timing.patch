+void G1Backend::enable_timing() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  timing_rows_.reserve(100000);
+  feedback_rows_.reserve(100000);
+  writer_rows_.reserve(100000);
+  timing_enabled_ = true;
+}
+void G1Backend::timing_source(std::int64_t receive_ns, std::int64_t step_ns) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  timing_receive_ = receive_ns;
+  timing_step_ = step_ns;
+}
+std::vector<std::array<std::int64_t, 6>> G1Backend::timing_rows() const {
